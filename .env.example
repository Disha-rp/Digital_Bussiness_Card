# ==============================================================================
# QRTRAC API Environment Configuration (Placeholder Template)
# Copy this file to .env in your project root for local development.
# NEVER commit .env files containing real secrets to version control.
# ==============================================================================

# --- Standard / Node.js Environment Variables ---
QRTRAC_BASE_URL=https://api.qrtrac.com/api
QRTRAC_CLIENT_ID=your_client_id_here
QRTRAC_CLIENT_SECRET=your_client_secret_here
QRTRAC_TEAM_ID=your_team_id_here

# --- Expo Client Runtime Variables (Required for Expo Go / Web / Bundles) ---
EXPO_PUBLIC_QRTRAC_BASE_URL=https://api.qrtrac.com/api
EXPO_PUBLIC_QRTRAC_CLIENT_ID=your_client_id_here
EXPO_PUBLIC_QRTRAC_CLIENT_SECRET=your_client_secret_here
EXPO_PUBLIC_QRTRAC_TEAM_ID=your_team_id_here

# App Environment (development | staging | production)
APP_ENV=development
